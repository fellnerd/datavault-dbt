# Worker Dockerfile
# Separate container for BullMQ job processing with dbt
# =====================================================
# Der Worker führt dbt Jobs aus (deploy, run, test)
# =====================================================

# Use Debian-based image for better MS ODBC Driver support
FROM node:22-slim

WORKDIR /app

# =====================================================
# Install dbt dependencies and Microsoft ODBC Driver
# =====================================================
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    git \
    unixodbc \
    unixodbc-dev \
    curl \
    gnupg2 \
    apt-transport-https \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Microsoft ODBC Driver 18 for SQL Server (Debian)
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg && \
    curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && \
    ACCEPT_EULA=Y apt-get install -y msodbcsql18 mssql-tools18 && \
    rm -rf /var/lib/apt/lists/*

# Add sqlcmd to PATH
ENV PATH="$PATH:/opt/mssql-tools18/bin"

# Verify ODBC installation
RUN odbcinst -q -d

# Install dbt-core and dbt-sqlserver
RUN pip3 install --break-system-packages \
    dbt-core==1.9.0 \
    dbt-sqlserver==1.9.0

# Create python symlink (Debian uses python3)
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Install dependencies
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Copy dbt project
COPY ./dbt ./dbt

# Install tsx for running TypeScript directly
RUN npm install -g tsx

# Environment variables
ENV NODE_ENV=production
ENV WORKER_CONCURRENCY=2

# dbt environment variables (override at runtime)
ENV DBT_PROFILES_DIR=/app/dbt
ENV MDS_DB_SERVER=""
ENV MDS_DB_DATABASE=""
ENV MDS_DB_USER=""
ENV MDS_DB_PASSWORD=""

# Run the worker
CMD ["tsx", "src/lib/queue/worker.ts"]
