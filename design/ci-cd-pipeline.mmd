flowchart TD
    %% ─── Trigger Sources ───────────────────────────────────────────
    GIT_PUSH["⬆️ git push"]
    WEB_UI["🖥️ GitLab Web UI\n(Run Pipeline)"]
    ADF["☁️ ADF Pipeline\n(HTTP Trigger)"]
    TAG["🏷️ git tag v*"]
    MR["🔀 Merge Request"]

    %% ─── Branches ──────────────────────────────────────────────────
    BRANCH_DEV["Branch: dev"]
    BRANCH_TEST["Branch: test"]
    BRANCH_MAIN["Branch: main"]

    %% ─── Stage: validate ───────────────────────────────────────────
    subgraph VALIDATE["Stage: validate"]
        CI_VALIDATE["ci:validate\n────────────\ndbt compile\ndbt test\n⏱ 30 min"]
    end

    %% ─── Stage: deploy ─────────────────────────────────────────────
    subgraph DEPLOY["Stage: deploy"]
        DEV["deploy:dev 🔄\n────────────\nstage_external_sources\ndbt run\ndbt test\n⏱ 90 min"]
        DEV_FR["deploy:dev:full-refresh ▶️\n────────────\nstage_external_sources\ndbt run --full-refresh\ndbt test\n⏱ 120 min"]

        TEST["deploy:test 🔄\n────────────\nstage_external_sources\ndbt run\ndbt test\n⏱ 90 min"]
        TEST_FR["deploy:test:full-refresh ▶️\n────────────\nstage_external_sources\ndbt run --full-refresh\ndbt test\n⏱ 120 min"]

        PROD["deploy:prod 🔄\n────────────\nstage_external_sources\ndbt run\ndbt test\n⏱ 90 min"]
        PROD_FR["deploy:prod:full-refresh ▶️\n────────────\nstage_external_sources\ndbt run --full-refresh\ndbt test\n⏱ 120 min"]
    end

    %% ─── Target Databases ──────────────────────────────────────────
    DB_DEV[("🗄️ datavault-dev")]
    DB_TEST[("🗄️ datavault-test")]
    DB_PROD[("🗄️ datavault\n(Prod)")]

    %% ─── Trigger → Branch ──────────────────────────────────────────
    MR --> CI_VALIDATE
    GIT_PUSH --> BRANCH_DEV
    GIT_PUSH --> BRANCH_TEST
    TAG --> BRANCH_MAIN

    WEB_UI -->|Branch wählen| BRANCH_DEV
    WEB_UI -->|Branch wählen| BRANCH_TEST
    WEB_UI -->|Branch wählen| BRANCH_MAIN

    ADF -->|"ref=dev"| BRANCH_DEV
    ADF -->|"ref=test"| BRANCH_TEST
    ADF -->|"ref=main"| BRANCH_MAIN

    %% ─── Branch → Job ──────────────────────────────────────────────
    BRANCH_DEV -->|auto bei push/changes| DEV
    BRANCH_DEV -->|manuell ▶️| DEV_FR

    BRANCH_TEST -->|auto| TEST
    BRANCH_TEST -->|manuell ▶️| TEST_FR

    BRANCH_MAIN -->|auto via Tag/ADF| PROD
    BRANCH_MAIN -->|manuell ▶️| PROD_FR

    %% ─── Job → DB ──────────────────────────────────────────────────
    DEV --> DB_DEV
    DEV_FR --> DB_DEV
    TEST --> DB_TEST
    TEST_FR --> DB_TEST
    PROD --> DB_PROD
    PROD_FR --> DB_PROD

    %% ─── Styles ────────────────────────────────────────────────────
    classDef trigger fill:#e8f4fd,stroke:#2196F3,color:#000
    classDef branch fill:#fff3e0,stroke:#FF9800,color:#000
    classDef job fill:#e8f5e9,stroke:#4CAF50,color:#000
    classDef job_fr fill:#fce4ec,stroke:#E91E63,color:#000
    classDef db fill:#f3e5f5,stroke:#9C27B0,color:#000

    class GIT_PUSH,WEB_UI,ADF,TAG,MR trigger
    class BRANCH_DEV,BRANCH_TEST,BRANCH_MAIN branch
    class CI_VALIDATE,DEV,TEST,PROD job
    class DEV_FR,TEST_FR,PROD_FR job_fr
    class DB_DEV,DB_TEST,DB_PROD db
