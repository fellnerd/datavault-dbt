---
title: "EWB Mart Layer — Projekt-Domain Star Schema (mart_project)"
---
erDiagram
    %% =====================================================================
    %% STAR SCHEMA — Projekt-Domain
    %% Pflicht-Spalten: {dim}_key, {dim}_id, {dim}_code, {dim}_name
    %% Ghost Records: vorerst nicht implementiert
    %% Materialisierung: view (Virtualisierung bevorzugt)
    %% =====================================================================

    dim_person {
        bigint person_key PK "SK = MD5(LOHNNR)"
        nvarchar person_id "Technische ID"
        nvarchar person_code "Initialen, Fallback PersonalNr"
        nvarchar person_name "Nachname Vorname, Fallback UNKNOWN"
        int abteilung_nr "sat_person.home_dept_nr"
        nvarchar abteilung "ref_abteilung, Fallback UNKNOWN"
        date mutation_date "Letzte Aenderung"
        date eintritt "sat_person.date_in"
        date austritt "sat_person.date_out"
        datetime2 dss_load_date "Ladezeitpunkt"
        nvarchar dss_record_source "Quelle"
    }

    dim_projekt {
        bigint projekt_key PK "SK = MD5(PROJNR)"
        nvarchar projekt_id "Technische ID"
        nvarchar projekt_code "ProjektNr als String"
        nvarchar projekt_name "Projektbezeichnung, Fallback UNKNOWN"
        int inaktiv "0=aktiv 1=inaktiv"
        int gruppe_nr "Referenz-Projektnummer"
        date erstellt "Erstellungsdatum"
        int status_nr "Status-Code"
        nvarchar status "ref_projektstatus, Fallback UNKNOWN"
        date status_datum "Letzte Statusaenderung"
        datetime2 dss_load_date "Ladezeitpunkt"
        nvarchar dss_record_source "Quelle"
    }

    dim_leistungsart {
        bigint leistungsart_key PK "SK = MD5(NUMBER)"
        nvarchar leistungsart_id "Technische ID"
        nvarchar leistungsart_code "Typ, Fallback NUMBER"
        nvarchar leistungsart_name "Beschreibung, Fallback UNKNOWN"
        int inaktiv "Inaktiv-Flag"
        datetime2 dss_load_date "Ladezeitpunkt"
        nvarchar dss_record_source "Quelle"
    }

    dim_date {
        int date_key PK "SK YYYYMMDD"
        date full_date "Natuerlicher Schluessel"
        int year "Jahr"
        int month "Monat"
        int quarter "Quartal"
        nvarchar month_name "Monatsname"
    }

    fakt_stunden {
        bigint projekt_key FK "dim_projekt"
        bigint leistungsart_key FK "dim_leistungsart"
        int datum_key FK "dim_date"
        decimal betrag "sat_projektsachkonto.azbetint"
        nvarchar gb "Geschaeftsbereich"
        int dataset "Abacus Dataset-Nr"
        datetime2 dss_load_date "Ladezeitpunkt"
        nvarchar dss_record_source "Quelle"
    }

    %% =====================================================================
    %% BEZIEHUNGEN (Star Schema)
    %% =====================================================================

    fakt_stunden }o--|| dim_projekt : "projekt_key"
    fakt_stunden }o--|| dim_leistungsart : "leistungsart_key"
    fakt_stunden }o--|| dim_date : "datum_key"

    %% dim_person ist eigenstaendig (kein FK von fakt_stunden)
    %% NSA hat keinen PersonalNr-Bezug

    %% =====================================================================
    %% VAULT-LINEAGE (Quell-Objekte pro Dimension/Fakt)
    %% =====================================================================
    %%
    %% dim_person       ← hub_adresse + sat_person_adresse (Name/Vorname)
    %%                    + hub_person + sat_person (Initialen, Abteilung)
    %%                    + link_adresse_person (ADR ↔ LEN)
    %%                    + ref_abteilung (Abteilungsname, GROUP=1)
    %%                    + ewb_publ_adr_main (Filter: LOHNJN=1, GESPERRT=0)
    %%
    %% dim_projekt      ← hub_projekt + sat_projekt (Stammdaten)
    %%                    + ref_projektstatus (Status-Aufloesung)
    %%
    %% dim_leistungsart ← ref_leistungsart (Beschreibung, Type, Inaktiv)
    %%
    %% dim_date         ← existiert bereits (mart._common.dim_date)
    %%
    %% fakt_stunden     ← hub_projektsachkonto + sat_projektsachkonto (Betraege)
    %%                    + link_projektsachkonto_projekt (NSA → NPO)
    %%                    + hub_projekt (ProjektNr fuer FK)
    %%
    %% =====================================================================
    %% KORREKTUREN gegenueber Synapse structured-tables:
    %%
    %% 1. fakt_stunden: NSA.PROJNR = ProjektNr (nicht PersonalNr)
    %% 2. dim_projekt: Sharepoint-Anreicherung nicht verfuegbar
    %% 3. dim_person: Initialen via dss_is_current statt alphabetisch
    %% 4. Ghost Records: vorerst nicht implementiert
    %% =====================================================================
