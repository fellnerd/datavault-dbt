erDiagram

    dim_abteilung_v {
        bigint abteilung_key "SK = MD5(home_dept_nr)"
        bigint person_key FK "dim_person_v"
        nvarchar abteilung_nr "home_dept_nr"
        nvarchar abteilung_name "GROUP=1 / Fallback UNKNOWN"
        nvarchar personal_nr "hub_person.empl_nr"
        date mutation_date "Mutationsdatum"
        datetime2 dss_load_date "Ladezeitpunkt"
        nvarchar dss_record_source "Quelle"
    }

    dim_person_v {
        bigint person_key PK "SK = MD5(LOHNNR)"
        nvarchar person_id "Technische ID"
        nvarchar person_code "Initialen / Fallback person_key"
        nvarchar person_name "Nachname, Vorname / Fallback UNKNOWN"
        int abteilung_nr "home_dept_nr"
        nvarchar abteilung "Abteilungsname"
        date mutation_date "Letzte Aenderung"
        date eintritt "Eintrittsdatum"
        int eintritt_date_key FK "dim_date"
        date austritt "Austrittsdatum"
        int austritt_date_key FK "dim_date"
        datetime2 dss_load_date "Ladezeitpunkt"
        nvarchar dss_record_source "Quelle"
    }

    dim_projekt_v {
        bigint projekt_key PK "SK = MD5(PROJNR)"
        nvarchar projekt_id "Technische ID"
        nvarchar projekt_code "ProjektNr / Fallback UNKNOWN"
        nvarchar projekt_name "Projektname"
        int inaktiv "0=aktiv 1=inaktiv"
        int gruppe_nr "REFPROJNR"
        nvarchar gruppe_name "SharePoint Gruppe"
        nvarchar hauptgruppe_nr "KategorieNr"
        nvarchar hauptgruppe_name "Kategoriename"
        date erstellt "Erstellungsdatum"
        int erstellt_date_key FK "dim_date"
        int status_nr "Status-Code"
        nvarchar status "Statusname"
        date status_datum "Letzte Statusaenderung"
        int status_datum_date_key FK "dim_date"
        datetime2 dss_load_date "Ladezeitpunkt"
        nvarchar dss_record_source "Quelle"
    }

    dim_leistungsart_v {
        bigint leistungsart_key PK "SK = MD5(NUMBER)"
        nvarchar leistungsart_id "Technische ID"
        nvarchar leistungsart_code "TYPE / Fallback NUMBER"
        nvarchar leistungsart_name "Beschreibung / Fallback UNKNOWN"
        int inaktiv "Inaktiv-Flag"
        datetime2 dss_load_date "Ladezeitpunkt"
        nvarchar dss_record_source "Quelle"
    }

    dim_date {
        int date_key PK "YYYYMMDD (interne Table, mart._common)"
        date full_date "Natuerlicher Schluessel"
        int year
        int iso_year
        int quarter
        nvarchar quarter_name
        int month
        nvarchar month_name
        nvarchar year_month
        int iso_week
        int day_of_month
        nvarchar day_name
        char is_weekend
        char is_weekday
        char is_last_day_of_month
        char is_first_day_of_quarter
        char is_last_day_of_quarter
        date first_day_of_quarter
        date last_day_of_quarter
        datetime2 dss_load_date
    }

    dim_date_v {
        int date_key PK "Publizierte View auf dim_date"
        date full_date
        nvarchar year_month
        int iso_week
        char is_today
        char is_yesterday
    }

    fakt_stunden_v {
        bigint projekt_key FK "dim_projekt_v"
        bigint leistungsart_key FK "dim_leistungsart_v nullable"
        int sachkonto_code "Degenerate Dimension"
        int perioden_date_key FK "dim_date"
        decimal betrag "AZBETINT"
        nvarchar gb "Geschaeftsbereich"
        int dataset "Abacus Dataset"
        datetime2 dss_load_date "Ladezeitpunkt"
        nvarchar dss_record_source "Quelle"
    }

    dim_date ||--|| dim_date_v : "SELECT * + is_today/is_yesterday"

    dim_person_v ||--o{ dim_abteilung_v : "person_key"
    dim_date o|--o{ dim_person_v : "eintritt_date_key"
    dim_date o|--o{ dim_person_v : "austritt_date_key"
    dim_date o|--o{ dim_projekt_v : "erstellt_date_key"
    dim_date o|--o{ dim_projekt_v : "status_datum_date_key"

    dim_projekt_v ||--o{ fakt_stunden_v : "projekt_key"
    dim_leistungsart_v o|--o{ fakt_stunden_v : "leistungsart_key"
    dim_date ||--o{ fakt_stunden_v : "perioden_date_key"

