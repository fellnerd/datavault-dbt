---
title: "EWB Mart Layer — Projekt-Domain Star Schema (mart_project)"
---
erDiagram
    %% =====================================================================
    %% STAR SCHEMA — Projekt-Domain
    %% Dimensionen (dim_*) mit INT Surrogate Keys
    %% Faktentabellen (fakt_*) mit FK-Beziehungen zu Dimensionen
    %% =====================================================================

    dim_person {
        int PersonalNr PK "Surrogate Key = EMPL_NR = LOHNNR"
        nvarchar Name "sat_person_adresse.name"
        nvarchar Vorname "sat_person_adresse.vorname"
        nvarchar Initialen "sat_person.abrv"
        int AbteilungNr "sat_person.home_dept_nr"
        nvarchar Abteilung "ref_abteilung.description (GROUP=1)"
        date MutationDate "sat_person.mutation_date"
        date Eintritt "sat_person.date_in"
        date Austritt "sat_person.date_out"
    }

    dim_projekt {
        int ProjektNr PK "Surrogate Key = NPO.PROJNR"
        nvarchar ProjektName "sat_projekt.projname"
        int Inaktiv "sat_projekt.inaktiv"
        int GruppeNr "sat_projekt.refprojnr"
        date Erstellt "sat_projekt.creation"
        int StatusNr "sat_projekt.status"
        nvarchar Status "ref_projektstatus.bezeichn"
        date StatusDatum "sat_projekt.status1"
    }

    dim_leistungsart {
        int LeistungsartNr PK "Surrogate Key = NTR.NUMBER"
        nvarchar Beschreibung "ref_leistungsart.description"
        nvarchar Typ "ref_leistungsart.type"
        int Inaktiv "ref_leistungsart.inaktiv"
    }

    dim_date {
        int date_key PK "Surrogate Key YYYYMMDD"
        date full_date "Natuerlicher Schluessel"
        int year "Jahr"
        int month "Monat"
        int quarter "Quartal"
        nvarchar month_name "Monatsname"
    }

    fakt_stunden {
        int ProjektNr FK "→ dim_projekt.ProjektNr"
        int LeistungsartNr FK "→ dim_leistungsart.LeistungsartNr"
        int DatumKey FK "→ dim_date.date_key"
        decimal Betrag "sat_projektsachkonto.azbetint"
        nvarchar GB "Geschaeftsbereich"
        int Dataset "Abacus Dataset-Nr"
    }

    %% =====================================================================
    %% BEZIEHUNGEN (Star Schema)
    %% =====================================================================

    fakt_stunden }o--|| dim_projekt : "ProjektNr"
    fakt_stunden }o--|| dim_leistungsart : "LeistungsartNr"
    fakt_stunden }o--|| dim_date : "DatumKey"

    %% dim_person ist eigenstaendig (kein FK von fakt_stunden)
    %% NSA hat keinen PersonalNr-Bezug

    %% =====================================================================
    %% VAULT-LINEAGE (Quell-Objekte pro Dimension/Fakt)
    %% =====================================================================
    %%
    %% dim_person       ← hub_adresse + sat_person_adresse (Name/Vorname)
    %%                    + hub_person + sat_person (Initialen, Abteilung)
    %%                    + link_adresse_person (ADR ↔ LEN)
    %%                    + ref_abteilung (Abteilungsname, GROUP=1)
    %%                    + ewb_publ_adr_main (Filter: LOHNJN=1, GESPERRT=0)
    %%
    %% dim_projekt      ← hub_projekt + sat_projekt (Stammdaten)
    %%                    + ref_projektstatus (Status-Aufloesung)
    %%
    %% dim_leistungsart ← ref_leistungsart (Beschreibung, Type, Inaktiv)
    %%
    %% dim_date         ← existiert bereits (mart._common.dim_date)
    %%
    %% fakt_stunden     ← hub_projektsachkonto + sat_projektsachkonto (Betraege)
    %%                    + link_projektsachkonto_projekt (NSA → NPO)
    %%                    + hub_projekt (ProjektNr fuer FK)
    %%
    %% =====================================================================
    %% KORREKTUREN gegenueber Synapse structured-tables:
    %%
    %% 1. fakt_stunden: NSA.PROJNR = ProjektNr (nicht PersonalNr)
    %%    Synapse-Bug: PROJNR = LOHNNR (97.5% Datenverlust)
    %%    DV-Korrektur: PROJNR = NPO.PROJNR via Link (97.5% Match)
    %%
    %% 2. dim_projekt: Sharepoint-Anreicherung nicht verfuegbar
    %%    (Kostenstellen, KategorisierungProjekte, ProjekteKategorien)
    %%
    %% 3. dim_person: Initialen via dss_is_current statt alphabetisch
    %% =====================================================================
