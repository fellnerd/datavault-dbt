---
title: "ER-Diagramm: Mart Telecom (mart_telecom)"
---

erDiagram
    dim_mobilvertrag_v {
        bigint vertrag_key PK "SK = MD5(vertrag_id)"
        nvarchar vertrag_id "Compax Vertrags-ID"
        nvarchar vertrag_code "= vertrag_id"
        nvarchar vertrag_name "Abo-Name / Fallback vertrag_id"
        nvarchar abo_name "Haupt-Abo"
        date aktivierungs_datum "Vertragsbeginn"
        date kundigungs_datum "NULL = aktiv"
        nvarchar is_active "Y/N"
        datetime2 dss_load_date
        nvarchar dss_record_source
    }

    dim_mobilkunde_v {
        bigint kunde_key PK "SK = MD5(kunde_id)"
        nvarchar kunde_id "Compax Kunden-ID"
        nvarchar kunde_code "= kunde_id"
        nvarchar kunde_name "immer UNKNOWN"
        nvarchar external_customer_id "Abacus Kundennummer"
        datetime2 dss_load_date
        nvarchar dss_record_source
    }

    dim_sim_v {
        bigint sim_key PK "SK = MD5(ICCID)"
        nvarchar sim_id "ICCID"
        nvarchar sim_code "= ICCID"
        nvarchar sim_name "= ICCID"
        datetime2 dss_load_date
        nvarchar dss_record_source
    }

    dim_date {
        int date_key PK "YYYYMMDD (interne Table, mart._common)"
        date full_date "Natuerlicher Schluessel"
        int year
        int quarter
        int month
        nvarchar month_name
        nvarchar year_month
        int iso_week
        nvarchar day_name
        char is_weekend
        datetime2 dss_load_date
    }

    dim_date_v {
        int date_key PK "Publizierte View auf dim_date"
        date full_date
        nvarchar year_month
        int iso_week
        char is_today
        char is_yesterday
    }

    fakt_cdr_v {
        bigint vertrag_key FK "dim_mobilvertrag_v"
        bigint kunde_key FK "dim_mobilkunde_v nullable"
        bigint sim_key FK "dim_sim_v"
        int verbindungs_datum_key FK "dim_date"
        nvarchar record_type "DATA / MOC / MTC / FORW / SMS / ROAM"
        nvarchar service_type
        nvarchar tarif "Degenerate Dimension"
        nvarchar event_id "Compax CDR-ID"
        bit is_roaming "1 = Roaming"
        decimal duration_sec "Sekunden"
        decimal bytes_out_mb "Datenvolumen in MB"
        decimal price
        decimal ws_price
        datetime2 connection_start
        nvarchar hk_link_cdr_event_tl "Traceability"
        datetime2 dss_load_date
        nvarchar dss_record_source
    }

    fakt_datenvolumen {
        bigint vertrag_key FK "dim_mobilvertrag_v"
        bigint kunde_key FK "dim_mobilkunde_v nullable"
        int verbindungs_datum_key FK "dim_date"
        int session_count "Anzahl Datensessions"
        decimal mb_total "MB gesamt"
        decimal gb_total "GB gesamt"
        decimal mb_national "MB national"
        decimal mb_roaming "MB Roaming"
        datetime2 dss_load_date
        nvarchar dss_record_source
    }

    fakt_datenvolumen_v {
        bigint vertrag_key FK "Publizierte View auf fakt_datenvolumen"
        bigint kunde_key FK "dim_mobilkunde_v nullable"
        int verbindungs_datum_key FK "dim_date"
        int session_count
        decimal mb_total
        decimal gb_total
        decimal mb_national
        decimal mb_roaming
        datetime2 dss_load_date
        nvarchar dss_record_source
    }

    fakt_anrufe {
        bigint vertrag_key FK "dim_mobilvertrag_v"
        bigint kunde_key FK "dim_mobilkunde_v nullable"
        int verbindungs_datum_key FK "dim_date"
        nvarchar record_type "MOC / MTC / FORW / SMS"
        bit is_roaming
        int anruf_count
        decimal duration_sec_total
        decimal duration_min_total
        datetime2 dss_load_date
        nvarchar dss_record_source
    }

    fakt_anrufe_v {
        bigint vertrag_key FK "Publizierte View auf fakt_anrufe"
        bigint kunde_key FK "dim_mobilkunde_v nullable"
        int verbindungs_datum_key FK "dim_date"
        nvarchar record_type "MOC / MTC / FORW / SMS"
        bit is_roaming
        int anruf_count
        decimal duration_sec_total
        decimal duration_min_total
        datetime2 dss_load_date
        nvarchar dss_record_source
    }

    dim_date ||--|| dim_date_v : "SELECT * + is_today/is_yesterday"
    fakt_datenvolumen ||--|| fakt_datenvolumen_v : "publizierte Wrapper-View"
    fakt_anrufe ||--|| fakt_anrufe_v : "publizierte Wrapper-View"

    dim_mobilvertrag_v ||--o{ fakt_cdr_v : "vertrag_key"
    dim_mobilkunde_v o|--o{ fakt_cdr_v : "kunde_key"
    dim_sim_v ||--o{ fakt_cdr_v : "sim_key"
    dim_date ||--o{ fakt_cdr_v : "verbindungs_datum_key"

    dim_mobilvertrag_v ||--o{ fakt_datenvolumen : "vertrag_key"
    dim_mobilkunde_v o|--o{ fakt_datenvolumen : "kunde_key"
    dim_date ||--o{ fakt_datenvolumen : "verbindungs_datum_key"

    dim_mobilvertrag_v ||--o{ fakt_anrufe : "vertrag_key"
    dim_mobilkunde_v o|--o{ fakt_anrufe : "kunde_key"
    dim_date ||--o{ fakt_anrufe : "verbindungs_datum_key"

