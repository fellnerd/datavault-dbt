{
    "name": "Copy_Stage_ewb",
    "properties": {
        "description": "Kopiert alle Dateien eines bestimmten Runs aus load-fs (historized) nach stage-fs (current). Entspricht Copy_Stage_v1_c6a. Ohne Synapse Serverless SQL Pool: Datumspfad via cw_load_date-Parameter (default: utcNow).",
        "activities": [
            {
                "name": "Delete_Stage_Files",
                "type": "Delete",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataset": {
                        "referenceName": "ParquetFolderDataset_ewb",
                        "type": "DatasetReference",
                        "parameters": {
                            "cw_fileSystem": "stage-fs",
                            "cw_folderPath": {
                                "value": "@concat(pipeline().parameters.cw_business_context, '/', pipeline().parameters.cw_source)",
                                "type": "Expression"
                            }
                        }
                    },
                    "enableLogging": false,
                    "storeSettings": {
                        "type": "AzureBlobFSReadSettings",
                        "recursive": true,
                        "wildcardFileName": "*"
                    }
                }
            },
            {
                "name": "Copy_Stage_Bulk",
                "type": "Copy",
                "dependsOn": [
                    {
                        "activity": "Delete_Stage_Files",
                        "dependencyConditions": [
                            "Succeeded",
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [
                    {
                        "name": "Source",
                        "value": "load-fs/@{pipeline().parameters.cw_business_context}/@{pipeline().parameters.cw_source}/historized/@{pipeline().parameters.cw_load_date}/@{trim(pipeline().parameters.cw_runId)}/"
                    },
                    {
                        "name": "Destination",
                        "value": "stage-fs/@{pipeline().parameters.cw_business_context}/@{pipeline().parameters.cw_source}/"
                    }
                ],
                "typeProperties": {
                    "source": {
                        "type": "ParquetSource",
                        "additionalColumns": [
                            {
                                "name": "dss_record_source",
                                "value": {
                                    "value": "@concat(pipeline().parameters.cw_business_context, '/', pipeline().parameters.cw_source)",
                                    "type": "Expression"
                                }
                            },
                            {
                                "name": "dss_load_date",
                                "value": {
                                    "value": "@replace(pipeline().parameters.cw_load_date, '/', '-')",
                                    "type": "Expression"
                                }
                            },
                            {
                                "name": "dss_run_id",
                                "value": {
                                    "value": "@pipeline().parameters.cw_runId",
                                    "type": "Expression"
                                }
                            },
                            {
                                "name": "dss_stage_timestamp",
                                "value": {
                                    "value": "@utcNow()",
                                    "type": "Expression"
                                }
                            },
                            {
                                "name": "dss_source_file_name",
                                "value": "$$FILENAME"
                            }
                        ],
                        "storeSettings": {
                            "type": "AzureBlobFSReadSettings",
                            "recursive": true,
                            "wildcardFileName": "*"
                        },
                        "formatSettings": {
                            "type": "ParquetReadSettings"
                        }
                    },
                    "sink": {
                        "type": "ParquetSink",
                        "storeSettings": {
                            "type": "AzureBlobFSWriteSettings",
                            "copyBehavior": "PreserveHierarchy"
                        },
                        "formatSettings": {
                            "type": "ParquetWriteSettings"
                        }
                    },
                    "enableStaging": false
                },
                "inputs": [
                    {
                        "referenceName": "ParquetFolderDataset_ewb",
                        "type": "DatasetReference",
                        "parameters": {
                            "cw_fileSystem": "load-fs",
                            "cw_folderPath": {
                                "value": "@concat(pipeline().parameters.cw_business_context, '/', pipeline().parameters.cw_source, '/historized/', pipeline().parameters.cw_load_date, '/', trim(pipeline().parameters.cw_runId))",
                                "type": "Expression"
                            }
                        }
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "ParquetFolderDataset_ewb",
                        "type": "DatasetReference",
                        "parameters": {
                            "cw_fileSystem": "stage-fs",
                            "cw_folderPath": {
                                "value": "@concat(pipeline().parameters.cw_business_context, '/', pipeline().parameters.cw_source)",
                                "type": "Expression"
                            }
                        }
                    }
                ]
            }
        ],
        "parameters": {
            "cw_runId": {
                "type": "String",
                "defaultValue": "manual-run"
            },
            "cw_business_context": {
                "type": "String",
                "defaultValue": "ewb"
            },
            "cw_source": {
                "type": "String",
                "defaultValue": "abacus"
            },
            "cw_load_date": {
                "type": "String",
                "defaultValue": "2026/03/17"
            }
        },
        "folder": {
            "name": "load-fs_ewb"
        },
        "annotations": [],
        "lastPublishTime": "2026-03-04T19:56:28Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}