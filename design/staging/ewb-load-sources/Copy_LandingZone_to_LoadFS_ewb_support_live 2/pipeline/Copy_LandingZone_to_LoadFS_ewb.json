{
    "name": "Copy_LandingZone_to_LoadFS_ewb",
    "properties": {
        "description": "Kopiert Parquet-Dateien aus landing-zone nach load-fs mit historisierten Pfaden (basierend auf Copy_AdventureWorksLT2025). Parameter cw_source bestimmt den Modulkontext im Zielpfad.",
        "activities": [
            {
                "name": "Copy_FIBU_GL_Folder",
                "description": "Kopiert alle FIBU/GL Parquet-Dateien (*.parquet) als Folder-Copy — kein jährliches Hardcoding mehr nötig",
                "type": "Copy",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [
                    {
                        "name": "Source",
                        "value": "landing-zone/FIBU/GL/*.parquet"
                    },
                    {
                        "name": "Destination",
                        "value": "@concat('load-fs/', pipeline().parameters.cw_business_concept, '/', pipeline().parameters.cw_source, '/historized/', formatDateTime(utcNow(), 'yyyy/MM/dd'), '/', pipeline().RunId, '/FIBU/GL/')"
                    }
                ],
                "typeProperties": {
                    "source": {
                        "type": "ParquetSource",
                        "storeSettings": {
                            "type": "AzureBlobFSReadSettings",
                            "wildcardFolderPath": "FIBU/GL",
                            "wildcardFileName": "*.parquet",
                            "recursive": false,
                            "enablePartitionDiscovery": false
                        },
                        "formatSettings": {
                            "type": "ParquetReadSettings"
                        }
                    },
                    "sink": {
                        "type": "ParquetSink",
                        "storeSettings": {
                            "type": "AzureBlobFSWriteSettings"
                        },
                        "formatSettings": {
                            "type": "ParquetWriteSettings"
                        }
                    },
                    "enableStaging": false,
                    "validateDataConsistency": false,
                    "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                            "allowDataTruncation": true,
                            "treatBooleanAsNumber": false
                        }
                    }
                },
                "inputs": [
                    {
                        "referenceName": "GenericParquetDataset_ewb",
                        "type": "DatasetReference",
                        "parameters": {
                            "cw_fileSystem": "landing-zone",
                            "cw_folderPath": "FIBU/GL",
                            "cw_fileName": "*"
                        }
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "GenericParquetDataset_ewb",
                        "type": "DatasetReference",
                        "parameters": {
                            "cw_fileSystem": "load-fs",
                            "cw_folderPath": {
                                "value": "@concat(pipeline().parameters.cw_business_concept, '/', pipeline().parameters.cw_source, '/historized/', formatDateTime(utcNow(), 'yyyy/MM/dd'), '/', pipeline().RunId, '/FIBU/GL')",
                                "type": "Expression"
                            },
                            "cw_fileName": "*"
                        }
                    }
                ]
            },
            {
                "name": "ForEach_Tables",
                "type": "ForEach",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@pipeline().parameters.cw_items",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 5,
                    "activities": [
                        {
                            "name": "Copy_LandingZone_to_LoadFS",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [
                                {
                                    "name": "Source",
                                    "value": "@concat('landing-zone/', item().source.folder, '/', item().source.file)"
                                },
                                {
                                    "name": "Destination",
                                    "value": "@concat('load-fs/', pipeline().parameters.cw_business_concept, '/', pipeline().parameters.cw_source, '/historized/.../', item().source.folder, '/', item().source.file)"
                                }
                            ],
                            "typeProperties": {
                                "source": {
                                    "type": "ParquetSource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": false,
                                        "enablePartitionDiscovery": false
                                    },
                                    "formatSettings": {
                                        "type": "ParquetReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false,
                                "validateDataConsistency": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "GenericParquetDataset_ewb",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "cw_fileSystem": "landing-zone",
                                        "cw_folderPath": {
                                            "value": "@item().source.folder",
                                            "type": "Expression"
                                        },
                                        "cw_fileName": {
                                            "value": "@item().source.file",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "GenericParquetDataset_ewb",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "cw_fileSystem": "load-fs",
                                        "cw_folderPath": {
                                            "value": "@concat(pipeline().parameters.cw_business_concept, '/', pipeline().parameters.cw_source, '/historized/', formatDateTime(utcNow(), 'yyyy/MM/dd'), '/', pipeline().RunId, '/', item().source.folder)",
                                            "type": "Expression"
                                        },
                                        "cw_fileName": {
                                            "value": "@item().source.file",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            }
        ],
        "parameters": {
