erDiagram
    hub_adresse {
        char64      hk_adresse          PK  "vault | Hash(INR)"
        nvarchar    inr                     "Abacus Adressnummer (Interne Referenznummer)"
        datetime2   dss_load_date           "metadata"
        varchar     dss_record_source       "metadata"
    }

    hub_vertrag {
        char64      hk_vertrag          PK  "vault | Hash(vertrag_id)"
        nvarchar    vertrag_id              "services.vertrags_nummer / cdr.contract_id"
        nvarchar    dss_business_key        "normierter BK via CONCAT_WS"
        datetime2   dss_load_date           "metadata"
        datetime2   dss_create_datetime     "metadata"
        varchar     dss_record_source       "metadata"
    }

    hub_kunde {
        char64      hk_kunde            PK  "vault | Hash(kunde_id)"
        nvarchar    kunde_id                "services.customer_id — aliasiert im Staging"
        nvarchar    dss_business_key        "normierter BK via CONCAT_WS"
        datetime2   dss_load_date           "metadata"
        datetime2   dss_create_datetime     "metadata"
        varchar     dss_record_source       "metadata"
    }

    sat_kunde__compax {
        char64      hk_kunde            FK  "vault | PK Teil 1"
        datetime2   dss_load_date           "PK Teil 2"
        char64      hd_kunde                "Hash Diff"
        nvarchar    external_customer_id    "Abacus INR → link_kunde_adresse (61% Match)"
        datetime2   dss_create_datetime     "metadata"
        varchar     dss_record_source       "metadata"
        char1       dss_is_current          "Y/N — via post_hook"
        datetime2   dss_end_date            "NULL=aktuell — via post_hook"
    }

    sat_vertrag_eff__compax {
        char64      hk_link_vertrag_kunde FK  "vault | PK — Link Hash"
        char64      hk_vertrag              FK  "vault | DFK (Driving FK)"
        char64      hk_kunde               FK  "vault | SFK (Secondary FK)"
        nvarchar    START_DATE                  "aktivierungs_datum — Vertragsbeginn"
        nvarchar    END_DATE                    "kundigungs_datum — 9999-12-31 = aktiv"
        datetime2   EFFECTIVE_FROM              "dss_load_date"
        datetime2   dss_load_date               "metadata"
        varchar     dss_record_source           "metadata"
    }

    sat_vertrag_optionen_ma__compax {
        char64      hk_vertrag          FK  "vault | PK Teil 1"
        datetime2   dss_load_date           "PK Teil 2"
        nvarchar    abo_option_name          "CDK — PK Teil 3 (Multi-Active Key)"
        char64      hd_vertrag_optionen_ma   "Hash Diff"
        nvarchar    ist_option               "0=Haupt-Abo / 1=Zusatzoption"
        nvarchar    aktivierungs_datum        "Aktivierungsdatum (Vertragsbeginn)"
        nvarchar    kundigungs_datum          "Kündigungsdatum (9999-12-31 = offen)"
        nvarchar    mlz_datum                "Mindestlaufzeit-Ende"
        datetime2   dss_create_datetime     "metadata"
        varchar     dss_record_source       "metadata"
    }

    link_vertrag_kunde {
        char64      hk_link_vertrag_kunde    PK  "vault | Hash(vertrag_id, kunde_id)"
        char64      hk_vertrag              FK  ""
        char64      hk_kunde               FK  ""
        datetime2   dss_load_date               "metadata"
        varchar     dss_record_source           "metadata"
    }


    link_kunde_adresse {
        char64      hk_link_kunde_adresse    PK  "vault | Hash(kunde_id, adresse_bk)"
        char64      hk_kunde                FK  "→ vault.hub_kunde"
        char64      hk_adresse              FK  "→ vault.hub_adresse"
        datetime2   dss_load_date               "metadata"
        varchar     dss_record_source           "metadata"
    }

    %% ============================================================
    %% SCHEMA: vault_telecom  (raw_vault/telecom/)
    %% Telekom-spezifische Objekte — SIM-Karten, CDR-Events, Referenzdaten
    %% Scope: RSN Mobile (Compax) + künftig RSN Festnetz
    %% ============================================================

    hub_sim {
        char64      hk_sim              PK  "vault_telecom | Hash(icc)"
        nvarchar    icc                     "services.icc = cdr.iccid (ICCID — global eindeutig)"
        nvarchar    dss_business_key        "normierter BK via CONCAT_WS"
        datetime2   dss_load_date           "metadata"
        datetime2   dss_create_datetime     "metadata"
        varchar     dss_record_source       "metadata"
    }

    hub_msisdn {
