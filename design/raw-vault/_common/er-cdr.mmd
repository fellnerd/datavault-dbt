        varchar     dss_record_source           "metadata"
    }

    link_cdr_event_tl {
        char64      hk_link_cdr_event_tl      PK  "vault_telecom | Hash(id, vertrag_id, icc)"
        char64      hk_vertrag              FK  "→ vault.hub_vertrag (via contract_id)"
        char64      hk_sim                  FK  "→ vault_telecom.hub_sim (via iccid)"
        datetime2   dss_load_date               "metadata"
        varchar     dss_record_source           "metadata"
    }

    sat_cdr_event__compax {
        char64      hk_link_cdr_event_tl  FK  "vault_telecom | PK Teil 1"
        datetime2   dss_load_date            "PK Teil 2 — non-historized, kein Hash Diff"
        nvarchar    id                       "CDR-Event-ID (Compax intern, ~2.7 Mrd)"
        nvarchar    signaling_start          "Beginn Signalisierung"
        nvarchar    connection_start         "Verbindungsbeginn"
        nvarchar    duration                 "Dauer in Sekunden"
        nvarchar    a                        "A-Rufnummer (Anrufer)"
        nvarchar    b                        "B-Rufnummer (Angerufener)"
        nvarchar    pai                      "P-Asserted-Identity"
        nvarchar    imsi                     "SIM-Netz-ID (228-02 = Sunrise CH)"
        nvarchar    iccid                    "SIM-Karten-ID (Verifikation)"
        nvarchar    record_type              "MOC / MTC / FORW / DATA / SMS"
        nvarchar    service_type             "GPR (Daten) / Voice / SMS"
        nvarchar    call_type                "Anruftyp"
        nvarchar    bytes_in                 "Empfangene Bytes — KERNMETRIK"
        nvarchar    bytes_out                "Gesendete Bytes — KERNMETRIK"
        nvarchar    price                    "Endkundenpreis"
        nvarchar    ws_price                 "Wholesale-Preis"
        nvarchar    tarif                    "Freitext-Tarif — Mart-Gruppierung"
        nvarchar    r_mcc_mnc                "Roaming MCC/MNC (leer = national)"
        nvarchar    result_code              "Ergebniscode"
        nvarchar    result_status            "Ergebnisstatus"
        nvarchar    privacy                  "Datenschutz-Flag"
        nvarchar    tap3                     "TAP3 Roaming-Record-Referenz"
        nvarchar    data_packet              "Datenpaket-Info"
        datetime2   dss_create_datetime      "metadata — kein dss_is_current, kein dss_end_date"
        varchar     dss_record_source        "metadata"
    }

    ref_abo_option_v {
        nvarchar    abo_option_name     PK  "vault_telecom | BK (z.B. Mobile M, 5GB Roaming Zone 2)"
        datetime2   dss_load_date           "metadata"
        varchar     dss_record_source       "metadata"
    }

    ref_tarif_v {
        nvarchar    tarif               PK  "vault_telecom | BK (z.B. Voice MO National)"
        datetime2   dss_load_date           "metadata"
        varchar     dss_record_source       "metadata"
    }

    %% === RELATIONSHIPS ===

    %% vault: Hub → Satellite
    hub_kunde       ||--o{ sat_kunde__compax               : "hk_kunde"

    %% vault: Hub → Link
    hub_kunde       ||--o{ link_kunde_adresse              : "hk_kunde"
    hub_adresse     ||--o{ link_kunde_adresse              : "hk_adresse"

    %% vault: Link → Effectivity Satellite
    link_vertrag_kunde ||--o{ sat_vertrag_eff__compax      : "hk_link_vertrag_kunde (automate_dv.eff_sat)"

    %% vault: Hub → MA Satellite
    hub_vertrag     ||--o{ sat_vertrag_optionen_ma__compax : "hk_vertrag (MA-CDK: abo_option_name)"

    %% vault: Hub → Link
    hub_vertrag     ||--o{ link_vertrag_kunde             : "hk_vertrag"
    hub_kunde       ||--o{ link_vertrag_kunde             : "hk_kunde"


    %% vault × vault_telecom: Cross-Schema Links
    hub_vertrag     ||--o{ link_vertrag_sim               : "vault.hk_vertrag"
    hub_sim         ||--o{ link_vertrag_sim               : "vault_telecom.hk_sim"

    hub_vertrag     ||--o{ link_vertrag_msisdn            : "vault.hk_vertrag"
    hub_msisdn      ||--o{ link_vertrag_msisdn            : "vault_telecom.hk_msisdn"

    hub_vertrag     ||--o{ link_cdr_event_tl               : "vault.hk_vertrag (via contract_id)"
    hub_sim         ||--o{ link_cdr_event_tl               : "vault_telecom.hk_sim (via iccid)"

    %% vault_telecom: Transaction Link → Transaction Satellite
    link_cdr_event_tl ||--o{ sat_cdr_event__compax         : "hk_link_cdr_event_tl"

    %% vault_telecom: Satellite → Reference (Lookup)
    sat_vertrag_optionen_ma__compax }o--|| ref_abo_option_v  : "abo_option_name"
    sat_cdr_event__compax           }o--|| ref_tarif_v        : "tarif"
