        nvarchar    rufnummer               "services.rufnummer (MSISDN / E.164)"
        nvarchar    dss_business_key        "normierter BK via CONCAT_WS"
        datetime2   dss_load_date           "metadata"
        datetime2   dss_create_datetime     "metadata"
        varchar     dss_record_source       "metadata"
    }

    link_vertrag_sim {
        char64      hk_link_vertrag_sim      PK  "vault_telecom | Hash(vertrag_id, icc)"
        char64      hk_vertrag              FK  "→ vault.hub_vertrag"
        char64      hk_sim                  FK  "→ vault_telecom.hub_sim"
        datetime2   dss_load_date               "metadata"
        varchar     dss_record_source           "metadata"
    }

    link_vertrag_msisdn {
