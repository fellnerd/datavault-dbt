erDiagram
    %% Data Vault 2.1 — EWB Raw Vault — STAMMDATEN DOMAIN
    %% Schema: vault | Quellen: Abacus ERP + IDMS
    %% Hubs: 3 | Sats: 5 | Links: 2 | Refs: 1
    %% Bereits implementiert: hub_person, hub_adresse (Multi-Source: Abacus INR + IDMS id→inr), hub_zeiterfassung, sat_person__abacus, sat_person_adresse__abacus, sat_adresse_kontakt__abacus, sat_adresse__idms, sat_zeiterfassung__abacus, link_adresse_person, link_zeiterfassung_person, ref_abteilung_v

    %% ========================================
    %% HUBS
    %% ========================================

    hub_person {
        char64 hk_person PK "SHA2_256(EMPL_NR)"
        nvarchar empl_nr "ext_ewb_lohn_len_main.EMPL_NR"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    hub_adresse {
        char64 hk_adresse PK "SHA2_256(INR)"
        nvarchar inr "ewb_publ_adr_main.INR / idms_address_main.id→inr"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    hub_zeiterfassung {
        char64 hk_zeiterfassung PK "SHA2_256(EMPLNR^^PROJDAT)"
        nvarchar emplnr "ext_ewb_proj_ntc_main.EMPLNR"
        date projdat "ext_ewb_proj_ntc_main.PROJDAT"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    %% ========================================
    %% SATELLITES
    %% ========================================

    sat_person__abacus {
        char64 hk_person FK "hub_person"
        char64 hd_person "hash diff"
        nvarchar empl_id "Mitarbeiter-ID (518 distinct)"
        nvarchar last_name "Nachname"
        nvarchar first_name "Vorname"
        nvarchar abrv "Initialen"
        nvarchar badge_id "Badge-ID (518 distinct)"
        date birthday "Geburtsdatum"
        nvarchar sex "Geschlecht"
        nvarchar nationality "CH/AT/DE/LI/..."
        nvarchar birth_place "Geburtsort"
        nvarchar home_dept_nr "FK ref_abteilung"
        nvarchar adr_inr "FK hub_adresse"
        date date_in "Eintrittsdatum"
        date date_out "Austrittsdatum (NULL=aktiv)"
        nvarchar type "M/S/R/J"
        date mutation_date "Mutationsdatum"
        decimal lpe_year "Letztes Lohnjahr"
        decimal lpe_month "Letzter Lohnmonat"
        nvarchar soc_insurance_nr "AHV-Nummer"
        decimal relevant_for_logib "Logib-relevant (0/1)"
        nvarchar zemis_nr "ZEMIS-Nr (nur Auslaender)"
        datetime2 dss_load_date "PK Teil 2"
        varchar dss_record_source "metadata"
        char dss_is_current "Y/N"
        datetime2 dss_end_date "NULL=aktuell"
    }

    sat_person_adresse__abacus {
        char64 hk_adresse FK "hub_adresse"
        char64 hd_person_adresse "hash diff"
        nvarchar name "Name"
        nvarchar vorname "Vorname"
        datetime2 dss_load_date "PK Teil 2"
        varchar dss_record_source "metadata"
        char dss_is_current "Y/N"
        datetime2 dss_end_date "NULL=aktuell"
    }

    sat_adresse_kontakt__abacus {
        char64 hk_adresse FK "hub_adresse"
        char64 hd_adresse_kontakt "hash diff"
        nvarchar plz "Postleitzahl"
        nvarchar ort "Ort"
        nvarchar street "Strasse"
        datetime2 dss_load_date "PK Teil 2"
        varchar dss_record_source "metadata"
        char dss_is_current "Y/N"
        datetime2 dss_end_date "NULL=aktuell"
    }

    sat_adresse__idms {
        char64 hk_adresse FK "hub_adresse"
        char64 hd_adresse__idms "hash diff"
        int anrede "Anrede-Code"
        int cust_id "Kunden-ID"
        int egid "Eidg. Gebäude-ID"
        nvarchar emailaddr "E-Mail"
        nvarchar fax "Fax"
        nvarchar firma "Firma"
        int flags "Bitmasken-Flags"
        nvarchar free_field "Freifeld"
        int mandate_id "Mandats-ID"
        nvarchar nachname "Nachname"
        int plzort "PLZ/Ort-Code"
        nvarchar postfach "Postfach"
        nvarchar ref "Referenz"
        int status "Status"
        nvarchar strasse "Strasse"
        nvarchar strasse_nr "Hausnummer"
        nvarchar tel "Telefon privat"
        nvarchar telg "Telefon geschäftlich"
        nvarchar telm "Telefon mobil"
        nvarchar vorname "Vorname"
        nvarchar zusatz "Adresszusatz"
        datetime2 dss_load_date "PK Teil 2"
        varchar dss_record_source "metadata"
        char dss_is_current "Y/N"
        datetime2 dss_end_date "NULL=aktuell"
    }

    sat_zeiterfassung__abacus {
        char64 hk_zeiterfassung FK "hub_zeiterfassung"
        char64 hd_zeiterfassung "hash diff"
        nvarchar from1_to10 "10 Zeitintervalle"
        decimal anzahl "Stunden"
        nvarchar user_f "Benutzer"
        datetime2 dss_load_date "PK Teil 2"
        varchar dss_record_source "metadata"
        char dss_is_current "Y/N"
        datetime2 dss_end_date "NULL=aktuell"
    }

    %% ========================================
    %% REFERENCE TABLE
    %% ========================================

    ref_abteilung_v {
        int nr PK "ext_ewb_lohn_ltc_main — 109 Gruppen"
        nvarchar description "Beschreibung"
        int group_nr "GROUP (=1 fuer Abteilungen)"
    }

    %% ========================================
    %% LINK
    %% ========================================

    link_adresse_person {
        char64 hk_link PK "SHA2_256(hk_person^^hk_adresse)"
        char64 hk_person FK "hub_person"
        char64 hk_adresse FK "hub_adresse"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    link_zeiterfassung_person {
        char64 hk_link PK "SHA2_256(hk_zeiterfassung^^hk_person)"
        char64 hk_zeiterfassung FK "hub_zeiterfassung"
        char64 hk_person FK "hub_person"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    %% ========================================
    %% RELATIONSHIPS — Hub → Satellite
    %% ========================================

    hub_person ||--o{ sat_person__abacus : has
    hub_adresse ||--o{ sat_person_adresse__abacus : has
    hub_adresse ||--o{ sat_adresse_kontakt__abacus : has
    hub_adresse ||--o{ sat_adresse__idms : has
    hub_zeiterfassung ||--o{ sat_zeiterfassung__abacus : has

    %% ========================================
    %% RELATIONSHIPS — Hub → Link
    %% ========================================

    hub_person ||--o{ link_adresse_person : "ADR.LOHNNR = LEN.EMPL_NR"
    hub_adresse ||--o{ link_adresse_person : "ADR.INR"
    hub_zeiterfassung ||--o{ link_zeiterfassung_person : "NTC.EMPLNR"
    hub_person ||--o{ link_zeiterfassung_person : "LEN.EMPL_NR"

    %% ========================================
    %% RELATIONSHIPS — Reference
    %% ========================================

    sat_person__abacus }o--|| ref_abteilung_v : "HOME_DEPT_NR zu NR"
