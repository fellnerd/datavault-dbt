erDiagram
    %% Data Vault 2.1 — EWB Raw Vault — PROJECT DOMAIN
    %% Schema: vault | Quelle: Abacus ERP
    %% Hubs: Projekt, Projektsachkonto
    %% Reference Tables: Leistungsart, Projektstatus

    %% ========================================
    %% HUBS
    %% ========================================

    hub_projekt {
        char64 hk_projekt PK "SHA2_256(PROJNR)"
        nvarchar projnr "ext_ewb_proj_npo_main.PROJNR"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    hub_projektsachkonto {
        char64 hk_projektsachkonto PK "SHA2_256(PROJNR^^CODE^^PERIYEAR^^PERIMONTH^^GB^^DATASET)"
        nvarchar projnr "ext_ewb_proj_nsa_main.PROJNR"
        nvarchar code "ext_ewb_proj_nsa_main.CODE"
        nvarchar periyear "ext_ewb_proj_nsa_main.PERIYEAR"
        nvarchar perimonth "ext_ewb_proj_nsa_main.PERIMONTH"
        nvarchar gb "ext_ewb_proj_nsa_main.GB"
        nvarchar dataset "ext_ewb_proj_nsa_main.DATASET (10 Datasets)"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    hub_projektteil {
        char64 hk_projektteil PK "SHA2_256(RECNUM)"
        nvarchar recnum "ext_ewb_proj_prt_main.RECNUM"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    %% ========================================
    %% SATELLITES
    %% ========================================

    sat_projekt__abacus {
        char64 hk_projekt FK "hub_projekt"
        char64 hd_projekt "hash diff"
        nvarchar projname "Projektname"
        bit inaktiv "Inaktiv-Flag"
        int refprojnr "GruppeNr (FK Kostenstelle)"
        decimal projgroup "Projektgruppe"
        int statusdef "Status-Definition"
        int status "StatusNr (FK ref_projektstatus)"
        date status1 "StatusDatum"
        date creation "Erstelldatum"
        datetime2 dss_load_date "PK Teil 2"
        varchar dss_record_source "metadata"
        char dss_is_current "Y/N"
        datetime2 dss_end_date "NULL=aktuell"
    }

    sat_projektsachkonto__abacus {
        char64 hk_projektsachkonto FK "hub_projektsachkonto"
        char64 hd_projektsachkonto "hash diff"
        decimal budgetint "Budget intern"
        decimal betragint "Betrag intern"
        decimal vortragint "Vortrag intern"
        decimal budgetext "Budget extern"
        decimal betragext "Betrag extern"
        decimal vortragext "Vortrag extern"
        decimal azbutint "AZ-Budget intern"
        decimal azbetint "AZ-Betrag intern"
        decimal azvortint "AZ-Vortrag intern"
        decimal azbutext "AZ-Budget extern"
        decimal azbetext "AZ-Betrag extern"
        decimal azvortext "AZ-Vortrag extern"
        datetime2 dss_load_date "PK Teil 2"
        varchar dss_record_source "metadata"
        char dss_is_current "Y/N"
        datetime2 dss_end_date "NULL=aktuell"
    }

    sat_projektteil__abacus {
        char64 hk_projektteil FK "hub_projektteil"
        char64 hd_projektteil "hash diff"
        date date "Datum"
        nvarchar stat1 "Status 1"
        nvarchar stat2 "Status 2"
        nvarchar user_f "Benutzer"
        datetime2 dss_load_date "PK Teil 2"
        varchar dss_record_source "metadata"
        char dss_is_current "Y/N"
        datetime2 dss_end_date "NULL=aktuell"
    }

    %% ========================================
    %% REFERENCE TABLES
    %% ========================================

    ref_leistungsart_v {
        int number PK "ext_ewb_proj_ntr_main — 29 Eintraege"
        nvarchar description "Beschreibung"
        nvarchar type "Typ"
        bit inaktiv "Inaktiv-Flag"
    }

    ref_projektstatus_v {
        decimal status PK "ext_ewb_proj_pst_main — 7 Eintraege"
        nvarchar bezeichn "Bezeichnung"
        nvarchar langcode "Sprachcode"
    }

    %% ========================================
    %% LINKS
    %% ========================================

    link_projektsachkonto_projekt {
        char64 hk_link PK "SHA2_256(hk_projektsachkonto^^hk_projekt)"
        char64 hk_projektsachkonto FK "hub_projektsachkonto"
        char64 hk_projekt FK "hub_projekt"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    link_projektteil_projekt {
        char64 hk_link PK "SHA2_256(hk_projektteil^^hk_projekt)"
        char64 hk_projektteil FK "hub_projektteil"
        char64 hk_projekt FK "hub_projekt"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    %% Cross-domain: Hauptbuch → Projekt (detail in er-finance.mmd)
    hub_hauptbuch {
        char64 hk_hauptbuch PK "siehe er-finance.mmd"
    }

    link_hauptbuch_projekt {
        char64 hk_link PK "cross-domain"
        char64 hk_hauptbuch FK "hub_hauptbuch"
        char64 hk_projekt FK "hub_projekt"
        datetime2 dss_load_date "metadata"
        varchar dss_record_source "metadata"
    }

    %% ========================================
    %% RELATIONSHIPS — Hub → Satellite
    %% ========================================

    hub_projekt ||--o{ sat_projekt__abacus : has
    hub_projektsachkonto ||--o{ sat_projektsachkonto__abacus : has
    hub_projektteil ||--o{ sat_projektteil__abacus : has

    %% ========================================
    %% RELATIONSHIPS — Hub → Link
    %% ========================================

    hub_projektsachkonto ||--o{ link_projektsachkonto_projekt : ""
    hub_projekt ||--o{ link_projektsachkonto_projekt : ""

    hub_projektteil ||--o{ link_projektteil_projekt : ""
    hub_projekt ||--o{ link_projektteil_projekt : ""

    %% Cross-domain
    hub_hauptbuch ||--o{ link_hauptbuch_projekt : ""
    hub_projekt ||--o{ link_hauptbuch_projekt : ""

    %% ========================================
    %% RELATIONSHIPS — Reference Tables
    %% ========================================

    sat_projektsachkonto__abacus }o--|| ref_leistungsart_v : "CODE zu NUMBER"
    sat_projekt__abacus }o--|| ref_projektstatus_v : "STATUS zu STATUS"
