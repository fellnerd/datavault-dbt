    %% ========================================
    %% HUBS (Business Keys)
    %% ========================================
    
    HUB_CUSTOMER {
        char64 hk_kunde PK
        int customerid
        datetime2 dss_load_date
        varchar dss_record_source
    }
    
    HUB_ADDRESS {
        char64 hk_address PK
        int addressid
        datetime2 dss_load_date
        varchar dss_record_source
    }
    
    HUB_PRODUCT {
        char64 hk_product PK
